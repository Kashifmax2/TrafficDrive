{
  "name": "kg-trf-tool",
  "version": "5.9.11",
  "productName": "KG TRF Tool",
  "description": "KG TRF Tool - Desktop Traffic Automation Application",
  "main": "main.js",
  "desktopName": "kg-trf-tool.desktop",
  "author": { "name": "KG TRF Tool", "email": "kgmax99@gmail.com" },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "server": "node -e \"require('./server.js').startServer()\"",
    "chromium:prepare": "node scripts/prepare-chromium.js",
    "smoke": "node scripts/smoke-test.js",
    "test:ads": "node scripts/adclick-test.js",
    "test:privacy": "node scripts/privacy-test.js",
    "test:system": "node scripts/system-check-test.js",
    "test:rotation": "node scripts/proxy-rotation-test.js",
    "test:validation": "node scripts/proxy-validation-policy-test.js",
    "build:win": "npm run chromium:prepare && electron-builder --win nsis portable --publish never",
    "build:linux": "npm run chromium:prepare && electron-builder --linux AppImage deb --publish never",
    "build:linux:dir": "npm run chromium:prepare && electron-builder --linux dir --x64",
    "pack:linux:tar": "node scripts/pack-linux-tar.js",
    "build:dir": "npm run chromium:prepare && electron-builder --dir"
  },
  "dependencies": {
    "extract-zip": "2.0.1",
    "playwright": "1.63.0",
    "socks": "2.8.10"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  }
}
