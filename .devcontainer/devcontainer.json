{
  "name": "KG TRF Tool",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [3000, 6080, 5900],
  "portsAttributes": {
    "3000": {
      "label": "KG TRF Tool dashboard (open this)",
      "onAutoForward": "notify"
    },
    "6080": {
      "label": "KG TRF Tool desktop (noVNC)",
      "onAutoForward": "notify"
    },
    "5900": {
      "label": "VNC (optional)",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": []
    }
  },
  "remoteUser": "node"
}
