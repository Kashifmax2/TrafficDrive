{
  "name": "TrafficDrive",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [6080, 3000, 5900],
  "portsAttributes": {
    "6080": {
      "label": "TrafficDrive desktop (noVNC)",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "TrafficDrive dashboard",
      "onAutoForward": "silent"
    },
    "5900": {
      "label": "VNC (optional)",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": []
    }
  },
  "remoteUser": "node"
}
